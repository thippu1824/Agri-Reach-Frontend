<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:background="#F4F7F2"

    android:fillViewport="true">
    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="22dp">
        <!-- Brand -->
        <TextView

            android:layout_width="216dp"

            android:layout_height="wrap_content"

            android:text="Amruth AgriReach"

            android:textColor="#247A3C"

            android:textSize="25sp"

            android:textStyle="bold" />
        <!-- Welcome Header -->
        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="#246B3B"

            app:cardCornerRadius="24dp"

            app:cardElevation="0dp">
            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="24dp">
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="ADMINISTRATION"

                    android:textColor="#C9E7D0"

                    android:textSize="12sp"

                    android:letterSpacing="0.12"

                    android:textStyle="bold" />
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Welcome back!"

                    android:textColor="#FFFFFF"

                    android:textSize="27sp"

                    android:textStyle="bold" />
                <TextView

                    android:id="@+id/adminWelcomeText"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="7dp"

                    android:text="Welcome, Admin!"

                    android:textColor="#E0F0E4"

                    android:textSize="15sp" />
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:text="Manage your workforce with AgriReach."

                    android:textColor="#E0F0E4"

                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Section heading -->
        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="30dp"

            android:text="Workspace"

            android:textColor="#202B22"

            android:textSize="21sp"

            android:textStyle="bold" />
        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Manage your employees and users"

            android:textColor="#778078"

            android:textSize="14sp" />
        <!-- Create Employee Card -->
        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardBackgroundColor="#FFFFFF"

            app:cardCornerRadius="20dp"

            app:cardElevation="1dp"

            app:strokeColor="#E8EEE7"

            app:strokeWidth="1dp">
            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="👤  Create Employee"

                    android:textColor="#243C2A"

                    android:textSize="18sp"

                    android:textStyle="bold" />
                <TextView

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="7dp"

                    android:text="Add new employees to your AgriReach workforce."

                    android:textColor="#778078"

                    android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton

                    android:id="@+id/createEmployeeButton"

                    android:layout_width="match_parent"

                    android:layout_height="54dp"

                    android:layout_marginTop="16dp"

                    android:text="Create Employee"

                    android:textAllCaps="false"

                    android:textSize="15sp"

                    app:backgroundTint="#287D43"

                    app:cornerRadius="14dp"

                    app:elevation="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- View Employees Card -->
        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            app:cardBackgroundColor="#FFFFFF"

            app:cardCornerRadius="20dp"

            app:cardElevation="1dp"

            app:strokeColor="#E8EEE7"

            app:strokeWidth="1dp">
            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="📋  Employee Directory"

                    android:textColor="#243C2A"

                    android:textSize="18sp"

                    android:textStyle="bold" />
                <TextView

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="7dp"

                    android:text="View and manage existing employees."

                    android:textColor="#778078"

                    android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton

                    android:id="@+id/viewEmployeesButton"

                    android:layout_width="match_parent"

                    android:layout_height="54dp"

                    android:layout_marginTop="16dp"

                    android:text="View Employees"

                    android:textAllCaps="false"

                    android:textSize="15sp"

                    android:textColor="#287D43"

                    app:backgroundTint="#EAF4EC"

                    app:cornerRadius="14dp"

                    app:elevation="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- User Management -->
        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            app:cardBackgroundColor="#FFFFFF"

            app:cardCornerRadius="20dp"

            app:cardElevation="1dp"

            app:strokeColor="#E8EEE7"

            app:strokeWidth="1dp">
            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="⚙️  User Management"

                    android:textColor="#243C2A"

                    android:textSize="18sp"

                    android:textStyle="bold" />
                <TextView

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="7dp"

                    android:text="Manage employee and manager accounts."

                    android:textColor="#778078"

                    android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton

                    android:id="@+id/manageUsersButton"

                    android:layout_width="match_parent"

                    android:layout_height="54dp"

                    android:layout_marginTop="16dp"

                    android:text="Manage Users"

                    android:textAllCaps="false"

                    android:textSize="15sp"

                    android:textColor="#287D43"

                    app:backgroundTint="#EAF4EC"

                    app:cornerRadius="14dp"

                    app:elevation="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Logout -->
        <com.google.android.material.button.MaterialButton

            android:id="@+id/logoutButton"

            android:layout_width="match_parent"

            android:layout_height="54dp"

            android:layout_marginTop="28dp"

            android:layout_marginBottom="20dp"

            android:text="Logout"

            android:textAllCaps="false"

            android:textColor="#B23B36"

            android:textSize="15sp"

            app:backgroundTint="#FCEDEC"

            app:cornerRadius="14dp"

            app:elevation="0dp" />
    </LinearLayout>
</ScrollView>
