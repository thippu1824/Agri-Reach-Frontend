<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:background="#F4F7F2"

    android:fillViewport="true">
    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="22dp">
        <!-- Header -->
        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Amruth AgriReach"

            android:textColor="#247A3C"

            android:textSize="25sp"

            android:textStyle="bold" />
        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:text="Training Videos"

            android:textColor="#202B22"

            android:textSize="25sp"

            android:textStyle="bold" />
        <TextView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Upload training videos for your employees."

            android:textColor="#778078"

            android:textSize="14sp" />
        <!-- Video Details Card -->
        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="#FFFFFF"

            app:cardCornerRadius="20dp"

            app:cardElevation="1dp"

            app:strokeColor="#E8EEE7"

            app:strokeWidth="1dp">
            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Video Information"

                    android:textColor="#243C2A"

                    android:textSize="19sp"

                    android:textStyle="bold" />
                <!-- Title -->
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="22dp"

                    android:text="Video Title"

                    android:textColor="#243C2A"

                    android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    app:boxBackgroundMode="outline"

                    app:boxCornerRadiusTopStart="12dp"

                    app:boxCornerRadiusTopEnd="12dp"

                    app:boxCornerRadiusBottomStart="12dp"

                    app:boxCornerRadiusBottomEnd="12dp"

                    app:hintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText

                        android:id="@+id/videoTitleInput"

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:hint="Enter video title"

                        android:inputType="textCapSentences"

                        android:maxLines="1"

                        android:padding="14dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <!-- Description -->
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:text="Description"

                    android:textColor="#243C2A"

                    android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    app:boxBackgroundMode="outline"

                    app:boxCornerRadiusTopStart="12dp"

                    app:boxCornerRadiusTopEnd="12dp"

                    app:boxCornerRadiusBottomStart="12dp"

                    app:boxCornerRadiusBottomEnd="12dp"

                    app:hintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText

                        android:id="@+id/videoDescriptionInput"

                        android:layout_width="match_parent"

                        android:layout_height="110dp"

                        android:gravity="top"

                        android:hint="Enter video description"

                        android:inputType="textCapSentences|textMultiLine"

                        android:padding="14dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <!-- Select Video -->
                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="24dp"

                    android:text="Video File"

                    android:textColor="#243C2A"

                    android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView

                    android:id="@+id/selectVideoCard"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    app:cardBackgroundColor="#F4F8F3"

                    app:cardCornerRadius="14dp"

                    app:strokeColor="#B9D8BF"

                    app:strokeWidth="1dp">
                    <LinearLayout

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:padding="24dp">
                        <TextView

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:text="🎥"

                            android:textSize="34sp" />
                        <TextView

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:layout_marginTop="10dp"

                            android:text="Choose MP4 Video"

                            android:textColor="#287D43"

                            android:textSize="16sp"

                            android:textStyle="bold" />
                        <TextView

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:text="Tap here to browse your files"

                            android:textColor="#778078"

                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Selected file information -->
                <TextView

                    android:id="@+id/selectedVideoText"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="No video selected"

                    android:textColor="#778078"

                    android:textSize="13sp" />
                <!-- Upload Button -->
                <com.google.android.material.button.MaterialButton

                    android:id="@+id/uploadVideoButton"

                    android:layout_width="match_parent"

                    android:layout_height="56dp"

                    android:layout_marginTop="26dp"

                    android:text="Upload Video"

                    android:textAllCaps="false"

                    android:textSize="16sp"

                    app:backgroundTint="#287D43"

                    app:cornerRadius="14dp"

                    app:elevation="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
