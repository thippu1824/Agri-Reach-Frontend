<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6F0"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">
        <!-- Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            <ImageView
                android:layout_width="150dp"
                android:layout_height="55dp"
                android:scaleType="fitCenter"
                android:src="@drawable/aof_logo"
                android:contentDescription="@string/logo_desc" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amruth AgriReach"
                    android:textColor="#174C35"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GROW TOGETHER"
                    android:textColor="#718675"
                    android:textSize="10sp"
                    android:letterSpacing="0.15" />
            </LinearLayout>
        </LinearLayout>
        <!-- Security banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#174C35">
            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:gravity="center"
                android:text="🔐"
                android:textSize="30sp"
                android:background="#FFFFFF" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Secure Your Account"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Create a new password to protect your AgriReach account and continue to your workspace."
                android:textColor="#D8E9DD"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
        <!-- Password form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:padding="20dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change Password"
                android:textColor="#174C35"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:text="Enter your current password and choose a new one."
                android:textColor="#778579"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT PASSWORD"
                android:textColor="#52675A"
                android:textSize="11sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/currentPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:hint="Enter current password"
                android:inputType="textPassword"
                android:padding="12dp"
                android:backgroundTint="#9BB5A1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="NEW PASSWORD"
                android:textColor="#52675A"
                android:textSize="11sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/newPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:hint="Enter new password"
                android:inputType="textPassword"
                android:padding="12dp"
                android:backgroundTint="#9BB5A1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="CONFIRM NEW PASSWORD"
                android:textColor="#52675A"
                android:textSize="11sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/confirmPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:hint="Re-enter new password"
                android:inputType="textPassword"
                android:padding="12dp"
                android:backgroundTint="#9BB5A1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Password must contain at least 8 characters."
                android:textColor="#718675"
                android:textSize="12sp" />
            <Button
                android:id="@+id/changePasswordButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Update Password"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#174C35" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="AgriReach • Growing a better tomorrow"
            android:textColor="#89988C"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>