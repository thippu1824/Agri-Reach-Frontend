<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#E5ECE3"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">
        <!-- Main Video Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <!-- Video Thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="112dp"
                android:layout_height="100dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E5F1E7">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌱"
                            android:textSize="34sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRAINING VIDEO"
                            android:textColor="#54815D"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="7dp"
                        android:background="#287D43"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Video Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/videoTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Organic Farming Techniques"
                    android:textColor="#194F2C"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/videoDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Learn essential farming practices"
                    android:textColor="#788579"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <!-- Status Badge -->
                <TextView
                    android:id="@+id/videoStatusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="#E5F1E7"
                    android:text="● ACTIVE"
                    android:textColor="#287D43"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <!-- Category / Crop Labels -->
        <TextView
            android:id="@+id/videoCategoryTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="#F0F5EE"
            android:text="🌾 General"
            android:textColor="#4D7655"
            android:textSize="11sp"
            android:visibility="gone" />
        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="12dp"
            android:background="#EDF1EB" />
        <!-- Metadata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/videoDurationTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="◷  12 min"
                android:textColor="#68796A"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/videoFileSizeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣  125 MB"
                android:textColor="#68796A"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/videoUploadDateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="↑  Uploaded 24 Nov 2026"
            android:textColor="#899589"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>